          "http": {
            "method": "POST",
            "url": "https://your-dokploy-instance.com/api/docker.uploadFileToContainer",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "containerId",
                  "type": "text",
                  "value": ""
