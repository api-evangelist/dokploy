              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "redirects-update",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-dokploy-instance.com/api/redirects.update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
