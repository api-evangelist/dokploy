{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dokploy admin gitlab API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
