                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "gitlab-getGitlabBranches",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-dokploy-instance.com/api/gitlab.getGitlabBranches",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query"
              },
              {
                "name": "owner",
                "value": "",
                "type": "query"
              },
              {
                "name": "repo",
                "value": "",
