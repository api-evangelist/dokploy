          "http": {
            "method": "POST",
            "url": "https://your-dokploy-instance.com/api/gitlab.create",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "gitlab-one",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-dokploy-instance.com/api/gitlab.one",
            "params": [
              {
                "name": "gitlabId",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "gitlab-gitlabProviders",
            "type": "http"
          },
          "http": {
            "method": "GET",
