          },
          "http": {
            "method": "POST",
            "url": "https://your-dokploy-instance.com/api/gitlab.testConnection",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "gitlab-update",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-dokploy-instance.com/api/gitlab.update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
